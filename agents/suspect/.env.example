# Local agent only. Deployed values must be set using agentengine secret set.
MONGODB_URI=
DB_NAME=mystery
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMS=1024
EMBEDDING_API_KEY=
# Gemini uses a Google AI Studio API key in LLM_API_KEY.
# For OpenAI, use LLM_PROVIDER=openai and an OpenAI model/key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
RUMOUR_TTL_SECONDS=600
