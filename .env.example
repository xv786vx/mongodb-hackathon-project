# Atlas — each dev uses their own M10 and DB_NAME; Cluster0/mystery is for integration + demo
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
DB_NAME=mystery_dev_<yourname>

# Embeddings — EMBEDDING_DIMS must equal numDimensions in memory_index
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMS=1024

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# Bot/smoke client only; never provision these secrets to the suspect workspace
AGENT_ENGINE_PROJECT_ID=6af88435eee09d5d80696a95
AGENT_ENGINE_WORKSPACE_ID=
AGENT_ENGINE_CLIENT_ID=
AGENT_ENGINE_CLIENT_SECRET=

# Game tuning
RUMOUR_TTL_SECONDS=600
