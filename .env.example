# Bot variables. Copy to .env and fill in. Never commit .env.
# Discord IDs: run `python -m bot.discover_ids` to print them.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
TEAM_ROLES=A:0,B:0                # team_id:role_id, comma separated
TEAM_CHANNELS=A:0,B:0             # team_id:private channel id
HOST_ROLE_ID=
HOST_CHANNEL_ID=
CASE_ROOM_CHANNEL_ID=

# --- Game ---
ENGINE_MODE=fake                  # fake | local | hosted
CASE_ID=case_manor

# --- Agent Engine (hosted mode). The bot is the only holder of these (AGENTS.md rule 9) ---
AGENT_ENGINE_PROJECT_ID=
AGENT_ENGINE_WORKSPACE_ID=
AGENT_ENGINE_CLIENT_ID=           # service account; exchanged for a bearer token
AGENT_ENGINE_CLIENT_SECRET=
# AGENT_ENGINE_API_KEY=           # optional static bearer token, used only if no client id/secret

# --- Voice ---
ELEVENLABS_API_KEY=
VOICE_MODEL=eleven_flash_v2_5

# --- Needed once the real engine is wired in (same values as agents/suspect/.env) ---
# MONGODB_URI=
# DB_NAME=mystery
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=voyage-3.5
# EMBEDDING_DIMS=1024
# RUMOUR_TTL_SECONDS=
