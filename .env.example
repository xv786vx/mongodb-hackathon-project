# Copy to .env and fill in. Never commit .env.
# Discord IDs: run `python -m bot.discover_ids` to print them.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
TEAM_ROLES=A:0,B:0                # team_id:role_id, comma separated
TEAM_CHANNELS=A:0,B:0             # team_id:private channel id
HOST_ROLE_ID=
HOST_CHANNEL_ID=
CASE_ROOM_CHANNEL_ID=

# --- Game ---
ENGINE_MODE=fake                  # fake | local | hosted
CASE_ID=case_manor

# --- Agent Engine (hosted mode). The bot is the only holder of these (AGENTS.md rule 9) ---
AGENT_ENGINE_PROJECT_ID=6af88435eee09d5d80696a95
AGENT_ENGINE_WORKSPACE_ID=ws-6af8c0b85e1f510db9b7a4f2
AGENT_ENGINE_CLIENT_ID=           # service account; exchanged for a bearer token
AGENT_ENGINE_CLIENT_SECRET=
# AGENT_ENGINE_API_KEY=           # optional static bearer token, used only if no client id/secret

# --- Voice ---
ELEVENLABS_API_KEY=
VOICE_MODEL=eleven_flash_v2_5
# Local testing only, until the case document carries suspects[].voice_id (the case wins when both exist):
# VOICE_IDS=butler:<voice_id>,cook:<voice_id>,gardener:<voice_id>,niece:<voice_id>

# --- Atlas: each dev uses their own M10 and DB_NAME; Cluster0/mystery is for integration + demo ---
# (needed by the bot once the real engine is wired in; same values as agents/suspect/.env)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
DB_NAME=mystery_dev_<yourname>

# --- Embeddings: EMBEDDING_DIMS must equal numDimensions in memory_index ---
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMS=1024

# --- LLM (local mode; Google AI Studio key for Gemini, OpenAI also supported) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# --- Game tuning ---
RUMOUR_TTL_SECONDS=600
