# Atlas — each dev uses their own M10 and DB_NAME; Cluster0/mystery is for integration + demo
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
DB_NAME=mystery_dev_<yourname>

# Embeddings — EMBEDDING_DIMS must equal numDimensions in memory_index
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMS=1024

# LLM
LLM_API_KEY=
LLM_MODEL=

# Game tuning
RUMOUR_TTL_SECONDS=600
